<UserControl x:Class="Wpf_Inventory_.View.Controls.OfficeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Inventory_.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
            <!-- Панель инструментов -->
        <ToolBar Background="White" Margin="-12,0,-12,0" Foreground="White" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="NaN">
            <Button Content="Добавить" Padding="1" Margin="5" Click="AddButton_Click"/>
            <Button Content="Удалить" Padding="1" Margin="5" Click="DeleteButton_Click"/>
            <Button Content="Обновить" Padding="1" Margin="5" Click="UpdateButton_Click"/>
        </ToolBar>
        <DataGrid x:Name="OfficeDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="OfficeDataGrid_MouseDoubleClick" Margin="0,0,0,39">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Блок" Binding="{Binding Block}" Width="auto"/>
                <DataGridTextColumn Header="Номер Офиса" Binding="{Binding Officenum}" Width="auto"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="auto"/>
                <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
            <!-- Панель инструментов -->
    </Grid>
    
</UserControl>
