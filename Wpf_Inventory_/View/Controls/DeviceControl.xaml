<UserControl x:Class="Wpf_Inventory_.View.Controls.DeviceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Inventory_.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:Classes="clr-namespace:Wpf_Inventory_.Classes">

    <Control.Resources>
        <Classes:NullableBoolToBoolConverter x:Key="NullableBoolConverter"/>
    </Control.Resources>

    <Grid>
        <Grid x:Name="DeviceGrid" Background="#FFE5E5E5">
            <!-- Панель инструментов -->
            <ToolBar Background="White" Margin="-12,0,-12,0" Foreground="White" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="NaN">
                <StackPanel Orientation="Horizontal" Margin="10,0,20,0">
                    <Button Content="Добавить" Click="DeviceAddButton_Click" Padding="1" Margin="5"/>
                    <Button Content="Удалить" Padding="1" Margin="5"/>
                    <Button Content="Обновить" Padding="1" Margin="5"/>
                </StackPanel>

                <Separator/>

                <Grid Width="Auto" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ComboBox для выбора критерия поиска -->
                    <ComboBox x:Name="SearchCriteriaComboBox" Width="120" Background="WhiteSmoke" Margin="20,0,2,0" BorderThickness="1" BorderBrush="Black" Grid.Column="0">
                        <ComboBoxItem Content="Название"/>
                        <ComboBoxItem Content="Инвентарный номер"/>
                        <ComboBoxItem Content="IP"/>
                        <ComboBoxItem Content="Дата приема"/>
                    </ComboBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <!-- TextBox для ввода поискового запроса -->
                        <TextBox x:Name="SearchTextBox" Width="170" Background="WhiteSmoke" BorderThickness="1" BorderBrush="Black" Margin="5,0,5,0"/>
                        <!-- Кнопка для запуска поиска -->
                        <Button Content="Поиск" Click="SearchButton_Click" Padding="1" Margin="5" Background="WhiteSmoke" BorderThickness="1" BorderBrush="Black"/>
                    </StackPanel>
                </Grid>
            </ToolBar>


            <DataGrid x:Name="DeviceDataGrid" AutoGenerateColumns="False" SelectionChanged="DeviceDataGrid_SelectionChanged"
 MouseDoubleClick="DeviceDataGrid_MouseDoubleClick" Margin="0,0,0,39" IsReadOnly="True">

                <DataGrid.Resources>
                    <!-- Определение полупрозрачного серо-бур-малинового цвета -->
                    <SolidColorBrush x:Key="MarkedRowBrush" Color="#80B76E79"/>
                    <!-- 80 - прозрачность -->
                </DataGrid.Resources>
                <DataGrid.CacheMode>
                    <BitmapCache/>
                </DataGrid.CacheMode>

                <!-- Стиль для окраски строки -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <!-- Проверка свойства Exception -->
                            <DataTrigger Binding="{Binding Exception}" Value="True">
                                <Setter Property="Background" Value="{StaticResource MarkedRowBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инвентарный номер" Binding="{Binding Inventorynumber}" Width="auto"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Devicetype.Type}" Width="auto"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Devicename}" Width="auto"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="auto"/>
                    <DataGridTextColumn Header="Дата приема" Binding="{Binding Dateofcommissioning}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Списано" Binding="{Binding Exception, Converter={StaticResource NullableBoolConverter}}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
            
        </Grid>
    </Grid>
</UserControl>
