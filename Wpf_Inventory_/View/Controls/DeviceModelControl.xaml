<UserControl x:Class="Wpf_Inventory_.View.Controls.DeviceModelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Inventory_.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
            <!-- Панель инструментов -->
        <ToolBar Background="White" Margin="-12,0,-12,0" Foreground="White" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="NaN">
            <Button Content="Добавить" Padding="1" Margin="5" Click="AddButton_Click"/>
            <Button Content="Удалить" Padding="1" Margin="5" Click="DeleteButton_Click"/>
            <Button Content="Обновить" Padding="1" Margin="5" Click="UpdateButton_Click"/>
            <Button Content="Сохранить" Padding="1" Margin="5" Click="SaveButton_Click"/>

            <Separator/>

            <Grid Width="Auto" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                    <!-- TextBox для ввода поискового запроса -->
                    <TextBox x:Name="SearchTextBox" Width="159" Background="WhiteSmoke" BorderThickness="1" BorderBrush="Black" Margin="5,0,5,0"/>
                    <Button Click="SearchButton_Click" Padding="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="25" Width="28">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                                    <Image x:Name="iconImage" Source="/Resources/Icons/icons8-поиск-250.png"
                                            Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Кнопка для запуска поиска -->
                </StackPanel>
            </Grid>
        </ToolBar>
        <DataGrid x:Name="ModelDataGrid" AutoGenerateColumns="False" IsReadOnly="False" MouseDoubleClick="ModelDataGrid_MouseDoubleClick" Margin="0,0,0,39">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель устройства" Binding="{Binding Model1}" Width="auto"/>
            </DataGrid.Columns>
        </DataGrid>
            <!-- Панель инструментов -->
    </Grid>
    
</UserControl>
