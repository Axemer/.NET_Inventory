<Window x:Class="Wpf_Inventory_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Inventory_"
        mc:Ignorable="d"
        Title="MainWindow" Loaded="Window_Loaded"
        xmlns:Classes="clr-namespace:Wpf_Inventory_.Classes" Width="629" Height="521">

    <Window.Resources>
        <Classes:NullableBoolToBoolConverter x:Key="NullableBoolConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- Нижняя строка состояния -->
        <StatusBar DockPanel.Dock="Bottom" Background="#2D2D30" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="Готово" Margin="10,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="Green" Margin="10"/>
            </StatusBarItem>
        </StatusBar>
        <Menu DockPanel.Dock="Top" Background="#2D2D30" Foreground="White">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>

            <!-- Левые элементы меню -->
            <MenuItem Header="Файл" DockPanel.Dock="Left">
                <MenuItem Header="Импорт" Click="DevicImportButton_Click"/>
                <MenuItem Header="Экспорт" Click="DeviceExportButton_Click"/>
                <MenuItem Header="Пинг Сервера" Click="PingServerButton_Click"/>
                <MenuItem Header="Пинг Базы данных" Click="PingDBButton_Click"/>
                <MenuItem Header="Синхронизировать" Click="DeviceSyncButton_Click"/>
                <MenuItem Header="Сохранить" Click="DeviceSaveButton_Click"/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Редактировать" DockPanel.Dock="Left">
                <MenuItem Header="Копировать"/>
                <MenuItem Header="Вставить"/>
            </MenuItem>
            <MenuItem Header="Помощь" DockPanel.Dock="Left">
                <MenuItem Header="О программе"/>
            </MenuItem>

            <!-- Индикатор активности (в правом верхнем углу) -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>
                <Grid.ToolTip>
                    <TextBlock x:Name="StatusTooltip" Text="Система работает стабильно"/>
                </Grid.ToolTip>
            </Grid>

        </Menu>








        <!-- Основное содержимое -->
        <TabControl DockPanel.Dock="Top">
            <TabItem Header="Устройства">
                <Grid x:Name="DeviceGrid" Background="#FFE5E5E5">
                    <!-- Панель инструментов -->
                    <ToolBar Background="White" Margin="-12,0,-12,0" Foreground="White" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="NaN">
                        <Button Content="Добавить" Click="DeviceAddButton_Click" Padding="1" Margin="5"/>
                        <Button Content="Удалить" Padding="1" Margin="5"/>
                        <Button Content="Обновить" Padding="1" Margin="5"/>
                    </ToolBar>
                    <DataGrid x:Name="DeviceDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DeviceDataGrid_SelectionChanged"
                        MouseDoubleClick="DeviceDataGrid_MouseDoubleClick" Margin="0,0,0,39">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Инвентарный номер" Binding="{Binding InventoryNumber}" Width="auto"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType.Type}" Width="auto"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding DeviceName}" Width="auto"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IP_Adress}" Width="auto"/>
                            <DataGridTextColumn Header="Дата приема" Binding="{Binding DateOfCommissioning}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Списано" Binding="{Binding Exception, Converter={StaticResource NullableBoolConverter}}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Панель инструментов -->
                </Grid>
            </TabItem>
            <TabItem Header="Рабочие места">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="47*"/>
                        <ColumnDefinition Width="747*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="WorkplaceDataGrid" Margin="0,0,0,72" Grid.ColumnSpan="2">
                        <DataGridTextColumn Header="ID" Binding="{Binding Device_Workplace_ID}" Width="25"/>
                        <DataGridTextColumn Header="Инвентарный номер" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding DeviceName}" Width="*"/>
                        <DataGridTextColumn Header="Дата приема" Binding="{Binding DateOfCommissioning}" Width="*"/>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя строка состояния -->
    </DockPanel>
</Window>
